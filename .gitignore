# devenv / direnv caches
.devenv/
.direnv/

# Rust build artifacts (task 2+ workspace output)
target/
**/target/

# Bounded development scratch (builds, sockets, guest images, snapshots)
.work/

# Preflight / evidence scratch produced outside the committed evidence tree
.preflight/

# Nix `nix build` / `nix run` symlink outputs
result
result-*

# Local editor / OS metadata
.idea/
.vscode/
*.swp
.DS_Store
# OMX orchestration state (local only)
.omo/

# Codegraph symlink (local only)
.codegraph

# Guest image artifacts built by scripts/build-guest-image.sh (large binaries:
# vmlinux + rootfs.ext4); consumed by scripts/prepare-bench-artifacts.sh.
guest/
