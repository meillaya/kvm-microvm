  "error_parity_mechanism": "Each MicrovmError maps to a deterministic tonic::Code; the structured ErrorBody (error_code/message/context) is carried verbatim in the gRPC status details as JSON, byte-identical to the REST response body. Test parity_error_body_bytes_identical_rest_and_grpc asserts REST body bytes == gRPC details bytes.",
  "security_invariants": {
    "unix_socket_only": true,
    "default_socket_path": "/run/microvm/api/grpc.sock",
    "separate_socket_from_rest": true,
    "no_tcp_patterns_in_source": true,
    "so_peercred_before_authorization": true,
    "socket_mode_validation": true,
    "socket_owner_validation": true,
    "reflection_disabled_const_guard": true,
    "no_tonic_reflection_dependency": true
  },
  "backend": "Arc<dyn microvm_lifecycle::LifecycleService>; production wiring is microvm_service::VmLifecycleService (compile-time bound verified by vm_lifecycle_service_satisfies_backend_bound)",
  "design_notes": {
    "tonic_version": "0.14 (codegen via tonic-prost-build + system protoc; runtime codec via tonic-prost)",
    "peer_principal_propagation": "Custom PeerStream wraps the accepted UnixStream and implements tonic Connected, injecting PeerConnectInfo (SO_PEERCRED creds + authenticated Principal) into every request's extensions; handlers reject absent/unauthenticated principals with PermissionDenied.",
    "serving": "tonic Server::builder().add_service(...).serve_with_incoming(UnixListenerStream) — no SocketAddr bind path exists."
  },
