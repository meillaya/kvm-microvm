  "commit_message": "feat(policy): enforce tenant ownership quotas and audit events",
  "status": "complete",
  "files_changed": [
    "crates/microvm-lifecycle/src/policy.rs",
    "crates/microvm-lifecycle/src/lib.rs"
  ],
  "module": "microvm-lifecycle::policy",
  "deliverables": {
    "ownership_policy": {
      "function": "authorize(principal, resource_owner, operation) -> Result<(), MicrovmError>",
      "rules": [
        "Principal TenantId must match resource_owner (typed comparison, not path strings)",
        "Cross-tenant access returns ErrorCode::PermissionDenied",
        "Role matrix: Owner=all, Operator=start/stop/status/metrics, Viewer=status/metrics"
      ]
    },
    "quota_types": {
      "TenantQuota": ["max_vcpus: u32", "max_memory_mib: u64", "max_disk_mib: u64", "max_vms: u32", "max_snapshots: u32"],
      "TenantUsage": ["vcpus_used: u32", "memory_mib_used: u64", "disk_mib_used: u64", "vm_count: u32", "snapshot_count: u32"],
      "function": "check_quota(quota, usage, requested) -> Result<(), MicrovmError>",
      "contract": "Returns ErrorCode::QuotaExceeded BEFORE any backend call; saturating arithmetic prevents overflow"
    },
    "audit_events": {
      "AuditEvent": ["timestamp", "tenant_id", "role", "resource_type", "resource_id", "operation", "result"],
      "ResourceType": ["Vm", "Image", "Snapshot"],
      "Operation": ["Create", "Start", "Stop", "Snapshot", "Restore", "Status", "Metrics"],
      "AuditResult": ["Success", "Denied", "Error"],
      "trait": "AuditLog { fn record(&self, event: AuditEvent) }",
      "in_memory_impl": "InMemoryAuditLog (Mutex<Vec<AuditEvent>>, Send+Sync)",
      "contract": "Every mutating request yields exactly one structured audit event (Operation::is_mutating)"
    }
  },
